// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LocationType {
  IN_PERSON
  GOOGLE_MEET
  PHONE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum CancelledBy {
  CLIENT
  COACH
}

enum CoachRole {
  /// Cross-platform "super admin" -- sees/manages every Coach's data. Not
  /// scoped to its own account for authorization purposes (see
  /// auth/roles.guard.ts and every ownership check, which special-cases
  /// this role as a bypass).
  ADMIN
  COACH
}

/// A Coach is both the bookable person AND the whole business: one website
/// always belongs to exactly one Coach (see CONTEXT.md "Standing decision:
/// one Tenant = one Coach, always" -- this model used to be split into a
/// separate Tenant + Coach, merged back into one once multi-coach-per-
/// business was explicitly ruled out).
model Coach {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  preferredLocale String    @default("hu")
  role            CoachRole @default(COACH)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Access tokens issued (JWT `iat`) before this timestamp are rejected --
  // lets an admin force-deauthorize a coach's existing sessions without
  // needing a server-side token store, since the 30-day JWT itself has no
  // other revocation path.
  sessionsRevokedAt DateTime?

  /// The coach's own site, set once at invite-acceptance time (see
  /// CoachesService.invite/acceptInvite). Must match one of the admin's
  /// already-allow-listed AllowedOrigin rows at invite time (so an invite
  /// can only ever point at a real, known site), but AllowedOrigin itself
  /// stays a separate, global, coach-agnostic CORS list -- this column is
  /// the only place "which coach owns this site" is recorded. @unique is
  /// what stops two coaches from ever sharing the same site.
  frontendUrl String? @unique

  eventTypes           EventType[]
  weeklyAvailabilities WeeklyAvailability[]
  overrides            AvailabilityOverride[]
  bookings             Booking[]
  settings             Settings?
  googleIntegration    GoogleIntegration?
}

model EventType {
  id              String         @id @default(cuid())
  coach           Coach          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  coachId         String
  title           String
  description     String?
  durationMinutes Int
  locations       LocationType[]
  /// Whole HUF amount. Null means no price is shown for this service at all
  /// (e.g. a coach who prices things on a separate page of their own site);
  /// 0 means explicitly free, shown as such.
  price           Int?
  /// Display order in the public catalog (ascending). Defaults to appended
  /// at the end; editable afterwards to reorder the listing.
  position        Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookings Booking[]

  @@index([coachId])
}

/// Recurring weekly working hours. Multiple rows per weekday are allowed
/// to support split shifts (e.g. 09:00-12:00 and 13:00-17:00).
model WeeklyAvailability {
  id          String   @id @default(cuid())
  coach       Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  coachId     String
  /// ISO weekday: 1 = Monday ... 7 = Sunday
  weekday     Int
  /// Minutes since midnight, in the business timezone
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([coachId, weekday])
}

/// Overrides the weekly schedule for one specific calendar date.
/// isUnavailable = true marks the whole day off (startMinute/endMinute unused).
/// Otherwise startMinute/endMinute replace the weekly hours for that date;
/// multiple rows on the same date support split ranges.
model AvailabilityOverride {
  id            String   @id @default(cuid())
  coach         Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  coachId       String
  date          DateTime @db.Date
  isUnavailable Boolean  @default(false)
  startMinute   Int?
  endMinute     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([coachId, date])
}

model Booking {
  id                 String        @id @default(cuid())
  eventType          EventType     @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  eventTypeId        String
  coach              Coach         @relation(fields: [coachId], references: [id], onDelete: Restrict)
  coachId            String
  startAt            DateTime
  endAt              DateTime
  location           LocationType
  clientName         String
  clientEmail        String
  clientPhone        String
  clientNote         String?
  locale             String        @default("hu")
  status             BookingStatus @default(CONFIRMED)
  cancelledBy        CancelledBy?
  cancellationReason String?
  manageToken        String        @unique
  googleEventId      String?
  meetLink           String?
  /// The coach's own frontend origin this booking was made through (from
  /// the creating request's Origin/Referer header -- see BookingsService.
  /// create()). Used to build this booking's own email links (manage URL,
  /// logo) so they point at the right coach's site, instead of a single
  /// global FRONTEND_URL that can only ever be correct for one coach. Null
  /// only for bookings predating this column or the rare non-browser
  /// caller with neither header.
  originUrl          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([coachId, startAt])
  @@index([status, startAt])
}

/// One row per Coach -- their business profile (address, cancellation
/// policy, timezone). Keyed directly by coachId (1:1 extension of Coach),
/// not a separate id.
model Settings {
  coachId                 String   @id
  coach                   Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  businessAddress         String   @default("")
  cancellationNoticeHours Int      @default(48)
  businessTimezone        String   @default("Europe/Budapest")
  /// "Name <address>" sender identity for this coach's Resend-verified
  /// domain (see #13). Null means this coach hasn't verified a domain in
  /// Resend yet -- EmailService falls back to the shared GMAIL_* sender
  /// until set via PATCH /settings.
  emailFrom               String?
  /// Public-facing business name shown in booking email letterheads (see
  /// BookingEmail.tsx) -- NOT the same as Coach.name, which is the account
  /// holder's own name for internal/admin purposes. Null falls back to
  /// Coach.name (see NotificationsService.buildContext).
  brandName               String?
  /// Shown under brandName in the email letterhead; null omits the line
  /// entirely (see #33).
  brandTagline            String?
  /// `{ light: {...9 hex fields}, dark: {...9 hex fields} }`, same shape as
  /// BookingEmail.tsx's EmailPalette -- this coach's email color theme.
  /// Null falls back to DEFAULT_EMAIL_PALETTE (Betti's own palette).
  emailBrandPalette       Json?
  updatedAt               DateTime @updatedAt
}

/// One row per Coach -- the Google account used to mint fresh Meet links
/// for their bookings (see #2). 1:1 extension of Coach, same pattern as
/// Settings.
model GoogleIntegration {
  coachId               String   @id
  coach                 Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  refreshTokenEncrypted String
  connectedEmail        String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Browser origins allowed through CORS (see main.ts's enableCors). Global,
/// not per-coach: this covers every coach's own frontend domain plus
/// non-coach tools (e.g. the admin tool, when hosted somewhere other than
/// localhost, which is always allowed regardless of this table -- see #35).
/// Managed via the admin tool, not a redeploy.
model AllowedOrigin {
  id        String   @id @default(cuid())
  origin    String   @unique
  label     String?
  createdAt DateTime @default(now())
}

# Database (matches docker-compose.yml). In production, two more vars are
# set alongside this one: DATABASE_POOLER_URL (Neon's *pooled* connection
# string, with ?pgbouncer=true appended -- used by the running app) and
# DATABASE_DIRECT_URL (the *direct* one, used only for migrations) -- see
# README "Production hosting". Neither is needed locally: plain Docker
# Postgres has no pooled/direct distinction, so DATABASE_URL alone is used
# everywhere (the app and migration tooling both fall back to it).
DATABASE_URL="postgresql://betti:betti@localhost:5432/betti_coaching_calendar?schema=public"

# App
PORT=3000
BUSINESS_TIMEZONE=Europe/Budapest

# Auth - the app stores coaches itself (email + bcrypt password hash) and
# issues its own JWTs. JWT_SECRET signs those tokens; at least 32 random
# characters. Generate with: openssl rand -base64 32
# There is no ADMIN_EMAIL/ADMIN_PASSWORD here on purpose - the one admin
# account is created via `node scripts/seed-admin.mjs`, typed once
# interactively, never stored in any env file.
JWT_SECRET="change-me-in-production-min-32-chars"

# Email sending - two mechanisms, chosen per coach (see EmailService):
#
# 1. Gmail SMTP (GMAIL_USER/GMAIL_APP_PASSWORD/EMAIL_FROM below) - the
#    fallback every coach uses until it verifies its own domain in Resend.
#    Authenticated with an App Password (NOT the account password): Google
#    Account -> Security -> 2-Step Verification (must be on) -> App
#    passwords -> generate one. EMAIL_FROM's address must be GMAIL_USER
#    itself, or a "Send mail as" alias configured in that Gmail account's
#    settings - Gmail SMTP overrides/rejects a From address it doesn't
#    recognize, which is exactly why this can't give each coach its own
#    sender identity.
# 2. Resend (RESEND_API_KEY below) - once a coach verifies its own sending
#    domain at resend.com/domains and sets Settings.emailFrom (via PATCH
#    /settings) to a "Name <address>" at that domain, its emails switch
#    over to Resend automatically. Optional: leave unset and every coach
#    just keeps using Gmail.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
EMAIL_FROM="Betti Coaching <you@gmail.com>"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Google OAuth (one platform-wide OAuth app; each coach connects its own
# Google account separately through it to mint Google Meet links - see #2)
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxx"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/admin/google/callback"

# Security - 32-byte key, base64-encoded, used to encrypt the stored Google
# refresh token at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-in-production-base64-32-bytes"

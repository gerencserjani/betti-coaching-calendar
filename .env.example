# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://betti:betti@localhost:5432/betti_coaching_calendar?schema=public"

# App
PORT=3000
BUSINESS_TIMEZONE=Europe/Budapest
FRONTEND_URL="http://localhost:5173"

# Auth - the app stores coaches itself (email + bcrypt password hash) and
# issues its own JWTs. JWT_SECRET signs those tokens; at least 32 random
# characters. Generate with: openssl rand -base64 32
# There is no ADMIN_EMAIL/ADMIN_PASSWORD here on purpose - the one admin
# account is created via `node scripts/seed-admin.mjs`, typed once
# interactively, never stored in any env file.
JWT_SECRET="change-me-in-production-min-32-chars"

# Email sending - via Gmail's own SMTP, authenticated as a real Gmail account
# using an App Password (NOT the account password): Google Account -> Security
# -> 2-Step Verification (must be on) -> App passwords -> generate one.
# EMAIL_FROM's address must be GMAIL_USER itself, or a "Send mail as" alias
# configured in that Gmail account's settings - Gmail SMTP overrides/rejects
# a From address it doesn't recognize.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
EMAIL_FROM="Betti Coaching <you@gmail.com>"

# Google OAuth (central account used to mint Google Meet links)
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxx"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/admin/google/callback"

# Security - 32-byte key, base64-encoded, used to encrypt the stored Google
# refresh token at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-in-production-base64-32-bytes"
